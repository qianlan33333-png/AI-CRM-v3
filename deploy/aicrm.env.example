AICRM_LISTEN_ADDR=127.0.0.1:8080
AICRM_RELEASE_SHA=replace-with-git-commit-sha
# Runtime role is fixed by each systemd unit. Do not set AICRM_ROLE in this
# shared environment file.
AICRM_DATABASE_URL=postgres://aicrm:replace-password@127.0.0.1:5432/aicrm?sslmode=disable
AICRM_PUBLIC_ORIGIN=https://id-dev.youcangogogo.com
AICRM_SURVEY_DATA_KEY=replace-with-base64url-encoded-32-byte-key
AICRM_SURVEY_OAUTH_ENABLED=false
AICRM_SURVEY_OAUTH_SCOPE=snsapi_userinfo
AICRM_IDENTITY_PHONE_DATA_KEY=
# Required together only when AICRM_SURVEY_OAUTH_ENABLED=true:
# AICRM_SURVEY_OAUTH_APP_ID=
# AICRM_SURVEY_OAUTH_SECRET=
# AICRM_SURVEY_OAUTH_OPEN_PLATFORM_ID=
AICRM_BOOTSTRAP_USERNAME=admin
AICRM_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
AICRM_BOOTSTRAP_DISPLAY_NAME=CRM Admin
AICRM_WORKER_OWNER=id-dev-wecom-worker
AICRM_WORKER_LIMIT=25
# HXC dashboard reads only the current HXC projection. These four values are
# all required before enabling; secrets must be set only in /etc/aicrm/aicrm.env.
AICRM_HXC_SYNC_ENABLED=false
# AICRM_HXC_SOURCE_DSN=user:password@tcp(host:3306)/database
# AICRM_HXC_UNIONID_SCOPE=wechat-open-platform:replace-platform-id
# AICRM_HXC_SUBJECT_HMAC_KEY=replace-with-at-least-32-random-bytes
# AI Assistant review UI is available by default. Machine intake and real
# private-message dispatch remain independently fail-closed.
AICRM_AI_ASSISTANT_UI_ENABLED=true
AICRM_AI_ASSISTANT_INTAKE_ENABLED=false
# Required together only when machine intake is enabled:
# AICRM_AI_ASSISTANT_INTEGRATION_KEY=
# AICRM_AI_ASSISTANT_INTEGRATION_SECRET=replace-with-at-least-32-characters
# AICRM_AI_ASSISTANT_INTEGRATION_ACTOR_ID=
AICRM_AI_ASSISTANT_DISPATCH_ENABLED=false
# Required only with true: private-message-authorized. Dispatch also requires
# AICRM_OUTBOUND_PROVIDER_ENABLED=true, WeCom and its contact Secret.
# AICRM_AI_ASSISTANT_PROVIDER_PERMISSION=
AICRM_OUTBOUND_PROVIDER_ENABLED=false
AICRM_WECOM_ENABLED=false
# Channel capabilities are independently fail-closed even when the shared
# Outbound worker is enabled. Provider read is required before publish.
AICRM_CHANNEL_PROVIDER_READ_ENABLED=false
AICRM_CHANNEL_QR_PROVIDER_ENABLED=false
AICRM_CHANNEL_MEDIA_PREP_PROVIDER_ENABLED=false
AICRM_CHANNEL_WELCOME_PROVIDER_ENABLED=false
AICRM_CHANNEL_TAG_PROVIDER_ENABLED=false
AICRM_GROUP_OPS_PROVIDER_ENABLED=false
# Read-only catalog sync is independently gated; id-dev must keep it false.
AICRM_WECOM_TAG_CATALOG_PROVIDER_ENABLED=false
# Required only with true: catalog-read-authorized
# AICRM_WECOM_TAG_CATALOG_PROVIDER_PERMISSION=
# Required together only when AICRM_WECOM_ENABLED=true (OAuth/JSSDK):
# AICRM_WECOM_CORP_ID=
# AICRM_WECOM_AGENT_ID=
# AICRM_WECOM_SECRET=
# AICRM_WECOM_CONTEXT_SIGNING_KEY=
AICRM_WECOM_CUSTOMER_SYNC_ENABLED=false
# Separate customer-contact Secret; required only when customer sync is enabled:
# AICRM_WECOM_CONTACT_SECRET=
AICRM_WECOM_CALLBACK_ENABLED=false
# Required together only when AICRM_WECOM_CALLBACK_ENABLED=true:
# AICRM_WECOM_CALLBACK_TOKEN=
# AICRM_WECOM_CALLBACK_AES_KEY=
# AICRM_CHANNEL_STATE_HMAC_KEY=
# Automation Operations has an independent write gate even when the shared
# effects worker and WeCom provider are enabled. Keep disabled through import
# and Shadow. Probe mode is valid only with an exact one-recipient limit.
AICRM_AUTOMATION_OPS_PROVIDER_MODE=disabled
AICRM_AUTOMATION_OPS_MAX_RECIPIENTS=1
# Required only for probe or limited mode: fixed-script-send-authorized
# AICRM_AUTOMATION_OPS_PROVIDER_PERMISSION=
# Optional signed membership webhook secret (minimum 32 characters):
# AICRM_AUTOMATION_OPS_WEBHOOK_SECRET=
# Payment Provider writes are independently gated and default to zero calls.
AICRM_WECHAT_PAY_PROVIDER_ENABLED=false
# Required together only when explicitly enabled:
# AICRM_WECHAT_PAY_APP_ID=
# AICRM_WECHAT_PAY_APP_SECRET=
# AICRM_WECHAT_PAY_APP_SCOPE=wechat-app:replace-app-id
# AICRM_WECHAT_PAY_MERCHANT_ID=
# AICRM_WECHAT_PAY_MERCHANT_SERIAL=
# AICRM_WECHAT_PAY_PRIVATE_KEY_PATH=/etc/aicrm/keys/wechatpay_merchant.pem
# AICRM_WECHAT_PAY_PLATFORM_CERT_PATH=/etc/aicrm/keys/wechatpay_platform.pem
# AICRM_WECHAT_PAY_API_V3_KEY=
# WeChat Shop refund writes, callback verification, and exact reconciliation
# are a separate gate from WeChat Pay and remain disabled by default.
AICRM_WECHAT_SHOP_PROVIDER_ENABLED=false
# Required together only when explicitly enabled:
# AICRM_WECHAT_SHOP_APP_ID=
# AICRM_WECHAT_SHOP_APP_SECRET=
# AICRM_WECHAT_SHOP_CALLBACK_TOKEN=
# AICRM_WECHAT_SHOP_CALLBACK_AES_KEY=
