AICRM_LISTEN_ADDR=127.0.0.1:8080
AICRM_RELEASE_SHA=replace-with-git-commit-sha
# Runtime role is fixed by each systemd unit. Do not set AICRM_ROLE in this
# shared environment file.
AICRM_DATABASE_URL=postgres://aicrm:replace-password@127.0.0.1:5432/aicrm?sslmode=disable
AICRM_PUBLIC_ORIGIN=https://id-dev.youcangogogo.com
AICRM_SURVEY_DATA_KEY=replace-with-base64url-encoded-32-byte-key
AICRM_SURVEY_OAUTH_ENABLED=false
# Required together only when AICRM_SURVEY_OAUTH_ENABLED=true:
# AICRM_SURVEY_OAUTH_APP_ID=
# AICRM_SURVEY_OAUTH_SECRET=
# AICRM_SURVEY_OAUTH_OPEN_PLATFORM_ID=
AICRM_BOOTSTRAP_USERNAME=admin
AICRM_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
AICRM_BOOTSTRAP_DISPLAY_NAME=CRM Admin
AICRM_WORKER_OWNER=id-dev-wecom-worker
AICRM_WORKER_LIMIT=25
AICRM_WECOM_ENABLED=false
# Read-only catalog sync is independently gated; id-dev must keep it false.
AICRM_WECOM_TAG_CATALOG_PROVIDER_ENABLED=false
# Required only with true: catalog-read-authorized
# AICRM_WECOM_TAG_CATALOG_PROVIDER_PERMISSION=
# Required together only when AICRM_WECOM_ENABLED=true (OAuth/JSSDK):
# AICRM_WECOM_CORP_ID=
# AICRM_WECOM_AGENT_ID=
# AICRM_WECOM_SECRET=
# AICRM_WECOM_CONTEXT_SIGNING_KEY=
AICRM_WECOM_CUSTOMER_SYNC_ENABLED=false
# Separate customer-contact Secret; required only when customer sync is enabled:
# AICRM_WECOM_CONTACT_SECRET=
AICRM_WECOM_CALLBACK_ENABLED=false
# Required together only when AICRM_WECOM_CALLBACK_ENABLED=true:
# AICRM_WECOM_CALLBACK_TOKEN=
# AICRM_WECOM_CALLBACK_AES_KEY=
# AICRM_CHANNEL_STATE_HMAC_KEY=
