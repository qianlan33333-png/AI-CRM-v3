AICRM_LISTEN_ADDR=127.0.0.1:8080
AICRM_RELEASE_SHA=development
AICRM_ROLE=api
AICRM_DATABASE_URL=postgres://aicrm:local-only@127.0.0.1:5432/aicrm?sslmode=disable
AICRM_PUBLIC_ORIGIN=https://id-dev.youcangogogo.com
AICRM_WECOM_ENABLED=false
# Narrow read-only enterprise tag catalog adapter. id-dev keeps this false.
AICRM_WECOM_TAG_CATALOG_PROVIDER_ENABLED=false
# Required only when explicitly enabling the read adapter:
# AICRM_WECOM_TAG_CATALOG_PROVIDER_PERMISSION=
AICRM_WECOM_CALLBACK_ENABLED=false
AICRM_WECHAT_PAY_PROVIDER_ENABLED=false
