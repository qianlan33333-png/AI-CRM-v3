AICRM_LISTEN_ADDR=127.0.0.1:8080
AICRM_RELEASE_SHA=development
AICRM_ROLE=api
AICRM_DATABASE_URL=postgres://aicrm:local-only@127.0.0.1:5432/aicrm?sslmode=disable
AICRM_PUBLIC_ORIGIN=https://id-dev.youcangogogo.com
AICRM_WECOM_ENABLED=false
# Narrow read-only enterprise tag catalog adapter. id-dev keeps this false.
AICRM_WECOM_TAG_CATALOG_PROVIDER_ENABLED=false
# Required only when explicitly enabling the read adapter:
# AICRM_WECOM_TAG_CATALOG_PROVIDER_PERMISSION=
AICRM_WECOM_CALLBACK_ENABLED=false
AICRM_WECHAT_PAY_PROVIDER_ENABLED=false
# Required together only when explicitly enabled:
# AICRM_WECHAT_PAY_APP_ID=
# AICRM_WECHAT_PAY_APP_SECRET=
# AICRM_WECHAT_PAY_APP_SCOPE=wechat-app:replace-app-id
# AICRM_WECHAT_PAY_MERCHANT_ID=
# AICRM_WECHAT_PAY_MERCHANT_SERIAL=
# AICRM_WECHAT_PAY_PRIVATE_KEY_PATH=/etc/aicrm/keys/wechatpay_merchant.pem
# AICRM_WECHAT_PAY_PLATFORM_CERT_PATH=/etc/aicrm/keys/wechatpay_platform.pem
# AICRM_WECHAT_PAY_API_V3_KEY=
AICRM_WECHAT_SHOP_PROVIDER_ENABLED=false

# HMAC secret for signed Automation Operations membership facts (optional, min 32).
# AICRM_AUTOMATION_OPS_WEBHOOK_SECRET=
