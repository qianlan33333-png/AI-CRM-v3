# Candidate only: source front door after target is ready.
# Never route by DNS here; callbacks forwarded back from target terminate locally.
server {
    listen 443 ssl;
    server_name www.youcangogogo.com youcangogogo.com;
    ssl_certificate /etc/letsencrypt/live/www.youcangogogo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.youcangogogo.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 32m;
    # Avoid logging callback/OAuth query material during the transition.
    access_log off;
    location = /api/h5/wechat-pay/notify {
        if ($request_method !~ ^(POST)$) { return 405; }
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host www.youcangogogo.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host www.youcangogogo.com;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location = /api/h5/wechat-pay/refund/notify {
        if ($request_method !~ ^(POST)$) { return 405; }
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host www.youcangogogo.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host www.youcangogogo.com;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location = /api/wechat-shop/notify {
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host www.youcangogogo.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host www.youcangogogo.com;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location = /api/internal/automation-conversion/laohuang-chat-results {
        add_header Retry-After 300 always;
        return 503;
    }
    location = /api/internal/automation-conversion/lobster-results {
        add_header Retry-After 300 always;
        return 503;
    }
    # V3 owns WeCom after grouped configuration handover. Includes exact
    # /wecom/external-contact/callback and /api/wecom/events, never local5002.
    location / {
        proxy_pass https://124.220.53.183;
        proxy_ssl_server_name on;
        proxy_ssl_name www.youcangogogo.com;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_next_upstream off;
        proxy_http_version 1.1;
        proxy_set_header Host www.youcangogogo.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host www.youcangogogo.com;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    server_name www.youcangogogo.com youcangogogo.com;
    return 308 https://www.youcangogogo.com$request_uri;
}
