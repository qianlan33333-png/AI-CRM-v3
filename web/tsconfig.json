{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "types": []
  },
  "include": ["src/**/*.ts", "v3/**/*.ts"]
}
